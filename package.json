{
  "name": "sigx-ssg-monorepo",
  "version": "0.4.1",
  "private": true,
  "description": "SignalX SSG — static site generator, SSR islands, router, and store",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "verify:catalog": "node scripts/check-catalog.mjs",
    "wt": "node scripts/worktree.mjs",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint packages/ssg/src packages/ssg-theme-daisyui/src",
    "lint:fix": "oxlint --fix packages/ssg/src packages/ssg-theme-daisyui/src",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules pnpm-lock.yaml",
    "publish:dry": "node scripts/publish.js --dry-run",
    "publish:all": "node scripts/publish.js",
    "publish:beta": "node scripts/publish.js --tag beta",
    "verify:pack": "node scripts/verify-pack.js",
    "version:set": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260704.1",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.47.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "SignalX",
    "sigx",
    "ssg",
    "ssr",
    "static-site-generator",
    "islands"
  ],
  "author": "Andreas Ekdahl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalxjs/ssg.git"
  },
  "homepage": "https://sigx.dev/ssg/",
  "bugs": {
    "url": "https://github.com/signalxjs/ssg/issues"
  },
  "packageManager": "pnpm@10.28.2"
}
