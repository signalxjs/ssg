{
    "name": "@sigx/ssg",
    "version": "0.15.0",
    "description": "Static Site Generator for SignalX with file-based routing, MDX support, and pluggable themes",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./vite": {
            "import": "./dist/vite/plugin.js",
            "types": "./dist/vite/plugin.d.ts"
        },
        "./build": {
            "import": "./dist/build.js",
            "types": "./dist/build.d.ts"
        },
        "./dev": {
            "import": "./dist/dev.js",
            "types": "./dist/dev.d.ts"
        },
        "./client": {
            "import": "./dist/client.js",
            "types": "./dist/client.d.ts"
        },
        "./virtual": {
            "types": "./src/client.d.ts"
        },
        "./styles.css": "./styles.css"
    },
    "sigx-cli": {
        "plugin": "./dist/plugin.js"
    },
    "files": [
        "dist",
        "src/client.d.ts",
        "styles.css"
    ],
    "scripts": {
        "build": "vite build && tsgo --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "ssg",
        "static-site-generator",
        "vite",
        "mdx",
        "markdown"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ssg.git",
        "directory": "packages/ssg"
    },
    "homepage": "https://sigx.dev/ssg/",
    "bugs": {
        "url": "https://github.com/signalxjs/ssg/issues"
    },
    "dependencies": {
        "@mdx-js/rollup": "^3.1.0",
        "esbuild": "^0.28.0",
        "fast-glob": "^3.3.2",
        "gray-matter": "^4.0.3",
        "hast-util-from-html": "^2.0.3",
        "hast-util-to-string": "^3.0.1",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-slug": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.0",
        "remark-mdx-frontmatter": "^5.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.1",
        "shiki": "^4.0.2",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0"
    },
    "peerDependencies": {
        "@sigx/cli": ">=0.4.0",
        "@sigx/router": ">=0.7.0 <0.8.0",
        "@sigx/server-renderer": ">=0.7.0 <0.8.0",
        "sigx": ">=0.7.0 <0.8.0",
        "vite": ">=8.0.0"
    },
    "peerDependenciesMeta": {
        "@sigx/cli": {
            "optional": true
        }
    },
    "devDependencies": {
        "@sigx/args": "^0.6.2",
        "@sigx/cli": "^0.4.2",
        "@sigx/router": "^0.7.0",
        "@sigx/server-renderer": "^0.7.0",
        "@sigx/vite": "^0.8.0",
        "@types/node": "^25.7.0",
        "sigx": "^0.7.0",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "vite": "^8.1.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
